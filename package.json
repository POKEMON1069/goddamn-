{
  "name": "qintara",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Qintara \u2014 a creative technology studio portfolio. Static, dependency-free front end built with Vite.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && npm run test:a11y && npm run test:behaviour",
    "test:a11y": "node scripts/audit.mjs",
    "test:behaviour": "node scripts/behaviour.mjs",
    "test:visual": "node scripts/visual.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sparticuz/chromium": "^138.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^24.0.0",
    "vite": "^5.4.10"
  }
}
